<%- include('partials/header') %>

<section class="details-card">
  <div class="details-media">
    <img
      src="<%= property.image_url || '/images/property-placeholder.svg' %>"
      alt="<%= property.title %>"
      class="property-hero"
      onerror="this.onerror=null;this.src='/images/property-placeholder.svg';"
    />
  </div>

  <div class="details-content">
    <div class="details-head">
      <p class="eyebrow">Property Overview</p>
      <h1><%= property.title %></h1>
      <div class="badge-row">
        <span class="pill"><%= property.type %></span>
        <span class="status <%= property.status.toLowerCase() %>"><%= property.status %></span>
      </div>
    </div>

    <p class="location">📍 <%= property.location %></p>
    <p class="price">$<%= Number(property.price).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>

    <div class="details-grid">
      <p><strong>Bedrooms</strong><span><%= property.bedrooms %></span></p>
      <p><strong>Bathrooms</strong><span><%= property.bathrooms %></span></p>
      <p><strong>Area</strong><span><%= Number(property.area).toFixed(2) %> m²</span></p>
      <p><strong>Type</strong><span><%= property.type %></span></p>
      <p><strong>Status</strong><span><%= property.status %></span></p>
      <p><strong>Location</strong><span><%= property.location %></span></p>
    </div>

    <section class="description-box">
      <h3>Description</h3>
      <p><%= property.description || 'No description provided.' %></p>
    </section>

    <div class="actions">
      <a href="/" class="btn btn-ghost">← Back to Listings</a>

      <% if (isLoggedIn) { %>
        <% if (property.status === 'Available') { %>
          <form action="/sold/<%= property.id %>" method="POST">
            <button type="submit" class="btn btn-soft">Mark as Sold</button>
          </form>
        <% } %>

        <form action="/delete/<%= property.id %>" method="POST">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
