<%- include('partials/header') %>

<div class="details-card">
  <h2><%= property.title %></h2>
  <p><strong>Location:</strong> <%= property.location %></p>
  <p><strong>Type:</strong> <%= property.type %></p>
  <p><strong>Bedrooms:</strong> <%= property.bedrooms %></p>
  <p><strong>Bathrooms:</strong> <%= property.bathrooms %></p>
  <p><strong>Area:</strong> <%= Number(property.area).toFixed(2) %> m²</p>
  <p><strong>Price:</strong> $<%= Number(property.price).toFixed(2) %></p>
  <p><strong>Status:</strong> <span class="status <%= property.status.toLowerCase() %>"><%= property.status %></span></p>
  <p><strong>Description:</strong> <%= property.description || 'No description provided.' %></p>

  <p><a href="/">← Back to all properties</a></p>
</div>

<%- include('partials/footer') %>
