<%- include('partials/header') %>

<h2>Add New House</h2>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form action="/add-house" method="POST" class="form-card">
  <label for="title">Title</label>
  <input type="text" id="title" name="title" value="<%= formData.title || '' %>" required />

  <label for="location">Location</label>
  <input type="text" id="location" name="location" value="<%= formData.location || '' %>" required />

  <label for="price">Price</label>
  <input type="number" id="price" name="price" step="0.01" min="0" value="<%= formData.price || '' %>" required />

  <button type="submit">Add House</button>
</form>

<%- include('partials/footer') %>
