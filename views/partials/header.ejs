<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Real Estate System</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="shell nav-shell">
      <a href="/" class="brand">
        <span class="brand-mark">HS</span>
        <span class="brand-text">House Sales</span>
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
      <label for="nav-toggle" class="nav-toggle-label">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="top-nav">
        <a href="/" class="nav-link">Home</a>

        <% if (isLoggedIn) { %>
          <a href="/dashboard" class="nav-link">Dashboard</a>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <a href="/add-property" class="nav-link">Add Property</a>
          <% } %>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="btn btn-ghost">Logout</button>
          </form>
        <% } else { %>
          <a href="/login" class="nav-link">Login</a>
          <a href="/register" class="btn btn-primary nav-login">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="shell page-shell">
    <% if (flash) { %>
      <div class="alert <%= flash.type === 'success' ? 'alert-success' : 'alert-error' %>"><%= flash.text %></div>
    <% } %>
