<%- include('partials/header') %>

<section class="panel form-panel">
  <div class="panel-head">
    <p class="eyebrow">Management</p>
    <h1>Edit Property #<%= property.id %></h1>
  </div>

  <% if (error) { %>
    <p class="error-banner"><%= error %></p>
  <% } %>

  <form action="/properties/<%= property.id %>/edit" method="POST" class="property-form">
    <div class="form-grid-modern">
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= property.title || '' %>" required />
      </div>

      <div class="form-field">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= property.location || '' %>" required />
      </div>

      <div class="form-field">
        <label for="price">Price</label>
        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= property.price || '' %>" required />
      </div>

      <div class="form-field">
        <label for="type">Type</label>
        <select id="type" name="type" required>
          <% ['Apartment', 'Villa', 'House', 'Chalet', 'Office'].forEach((propertyType) => { %>
            <option value="<%= propertyType %>" <%= property.type === propertyType ? 'selected' : '' %>><%= propertyType %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-field">
        <label for="bedrooms">Bedrooms</label>
        <input type="number" id="bedrooms" name="bedrooms" min="0" value="<%= property.bedrooms || 0 %>" required />
      </div>

      <div class="form-field">
        <label for="bathrooms">Bathrooms</label>
        <input type="number" id="bathrooms" name="bathrooms" min="0" value="<%= property.bathrooms || 0 %>" required />
      </div>

      <div class="form-field">
        <label for="area">Area (m²)</label>
        <input type="number" id="area" name="area" step="0.01" min="0" value="<%= property.area || 0 %>" required />
      </div>

      <div class="form-field">
        <label for="status">Status</label>
        <select id="status" name="status" required>
          <option value="Available" <%= property.status === 'Available' ? 'selected' : '' %>>Available</option>
          <option value="Sold" <%= property.status === 'Sold' ? 'selected' : '' %>>Sold</option>
        </select>
      </div>

      <div class="form-field">
        <label for="image_url">Image URL</label>
        <input type="url" id="image_url" name="image_url" value="<%= property.image_url || '' %>" />
      </div>

      <div class="form-field full">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5"><%= property.description || '' %></textarea>
      </div>
    </div>

    <div class="actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/dashboard" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
