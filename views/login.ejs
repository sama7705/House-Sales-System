<%- include('partials/header') %>

<section class="auth-wrap">
  <article class="auth-card">
    <p class="eyebrow">Admin Access</p>
    <h1>Welcome Back</h1>
    <p class="muted">Login to manage listings, publish new properties, and update statuses.</p>

    <% if (error) { %>
      <p class="error-banner"><%= error %></p>
    <% } %>

    <form action="/login" method="POST" class="stack-form" id="login-form">
      <div class="form-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required />
      </div>

      <div class="form-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
      </div>

      <button type="submit" class="btn btn-primary btn-block">Login</button>
      <p class="muted small-text">New here? <a href="/register">Create account</a></p>
    </form>
  </article>
</section>

<%- include('partials/footer') %>
