<%- include('partials/header') %>

<h2>All Houses</h2>

<% if (!isLoggedIn) { %>
  <p class="info">You are viewing as a guest. Login to add, sell, or delete houses.</p>
<% } %>

<% if (houses.length === 0) { %>
  <p>No houses found.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Location</th>
        <th>Price</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% houses.forEach((house) => { %>
        <tr>
          <td><%= house.id %></td>
          <td><%= house.title %></td>
          <td><%= house.location %></td>
          <td>$<%= Number(house.price).toFixed(2) %></td>
          <td>
            <span class="status <%= house.status.toLowerCase() %>"><%= house.status %></span>
          </td>
          <td class="actions">
            <% if (isLoggedIn) { %>
              <% if (house.status === 'Available') { %>
                <form action="/sold/<%= house.id %>" method="POST">
                  <button type="submit">Mark as Sold</button>
                </form>
              <% } %>

              <form action="/delete/<%= house.id %>" method="POST">
                <button type="submit" class="delete">Delete</button>
              </form>
            <% } else { %>
              <span class="muted">Login required</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
